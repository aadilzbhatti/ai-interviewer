# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the interviewer, grader, generator and vetting agents.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: where "Save solution" writes. Defaults to
# ~/Documents/Workspace/interview-questions/solutions
# SOLUTIONS_DIR=~/Documents/Workspace/interview-questions/solutions

# Optional: log every raw model request and response (prompts included) to .logs/.
# `npm run dev:debug` sets this for you. Leave it off for normal use.
# INTERVIEW_DEBUG_LOG=1
# DEBUG_LOG_DIR=.logs

# Optional: output token budget for question generation. A whole question with
# two reference solutions and 8-12 test cases is a lot of JSON; too low a value
# truncates the reply mid-object. Default 16000.
# GENERATION_MAX_TOKENS=16000

# Optional: where the server keeps its copy of your library (reviews, questions,
# sessions, history). One JSON file per record. Defaults to
# ~/Documents/Workspace/interview-questions/data
# INTERVIEW_DATA_DIR=~/Documents/Workspace/interview-questions/data

# Optional: store nothing here and forward all storage calls to another
# instance, e.g. a dev server sharing the library of the deployed copy.
# STORAGE_UPSTREAM=https://aadils-mac-mini.taile67486.ts.net:10000
